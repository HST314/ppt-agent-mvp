{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SampleSelection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "const": "1.0"
    },
    "selection_id": {
      "title": "selection_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "outline_hash": {
      "title": "outline_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "slide_ids": {
      "title": "slide_ids",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confirmed": {
      "title": "confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "selection_id",
    "task_id",
    "outline_hash",
    "slide_ids",
    "confirmed"
  ]
}
