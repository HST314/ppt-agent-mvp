{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueDisposition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "const": "1.0"
    },
    "disposition_id": {
      "title": "disposition_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "issue_id": {
      "title": "issue_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "action": {
      "title": "action",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "enum": [
        "resolve",
        "agent_fix",
        "manual",
        "waive",
        "defer"
      ]
    },
    "actor": {
      "title": "actor",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "enum": [
        "user",
        "system"
      ]
    },
    "created_at": {
      "title": "created_at",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "format": "date-time"
    },
    "target_deck_hash": {
      "title": "target_deck_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "rationale": {
      "title": "rationale",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
    }
  },
  "required": [
    "disposition_id",
    "task_id",
    "issue_id",
    "action",
    "actor",
    "created_at"
  ]
}
