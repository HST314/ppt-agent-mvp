{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClarificationSet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "const": "1.0"
    },
    "clarification_id": {
      "title": "clarification_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "questions": {
      "title": "questions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "title": "assumptions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmed": {
      "title": "confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "clarification_id",
    "task_id",
    "questions",
    "assumptions",
    "confirmed"
  ]
}
