{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "const": "1.0"
    },
    "delivery_id": {
      "title": "delivery_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "deck_hash": {
      "title": "deck_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "title": "files",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmed_by": {
      "title": "confirmed_by",
      "type": "string",
      "minLength": 1,
      "enum": [
        "user"
      ]
    },
    "confirmed_at": {
      "title": "confirmed_at",
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  },
  "required": [
    "delivery_id",
    "task_id",
    "deck_hash",
    "files",
    "confirmed_by",
    "confirmed_at"
  ]
}
