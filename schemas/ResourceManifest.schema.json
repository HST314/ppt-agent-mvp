{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "const": "1.0"
    },
    "manifest_id": {
      "title": "manifest_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "resources": {
      "title": "resources",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "title": "resource_id",
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "uri": {
            "title": "uri",
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "title": "media_type",
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "title": "content_hash",
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "resource_id",
          "uri",
          "media_type",
          "content_hash"
        ]
      }
    },
    "content_hash": {
      "title": "content_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "title": "created_at",
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  },
  "required": [
    "manifest_id",
    "task_id",
    "resources",
    "content_hash",
    "created_at"
  ]
}
