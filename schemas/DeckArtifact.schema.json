{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckArtifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "const": "1.0"
    },
    "artifact_id": {
      "title": "artifact_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "version": {
      "title": "version",
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "title": "kind",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "enum": [
        "sample",
        "deck"
      ]
    },
    "outline_hash": {
      "title": "outline_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "title": "content_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "title": "created_at",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "format": "date-time"
    }
  },
  "required": [
    "artifact_id",
    "task_id",
    "version",
    "kind",
    "outline_hash",
    "content_hash",
    "created_at"
  ]
}
