{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InspectionReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "schema_version",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "const": "1.0"
    },
    "issues": {
      "title": "issues",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "title": "issue_id",
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "severity": {
            "title": "severity",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
            "enum": [
              "warning",
              "blocker"
            ]
          },
          "code": {
            "title": "code",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
          },
          "message": {
            "title": "message",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
          },
          "slide_id": {
            "title": "slide_id",
            "type": "string",
            "minLength": 0,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})?$"
          },
          "level": {
            "title": "level",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
            "enum": [
              "element",
              "slide",
              "deck"
            ]
          },
          "element_id": {
            "title": "element_id",
            "type": "string",
            "minLength": 0,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,127})?$"
          },
          "evidence": {
            "title": "evidence",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
          },
          "suggestion": {
            "title": "suggestion",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
          },
          "source": {
            "title": "source",
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
          },
          "sources": {
            "title": "sources",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
            }
          },
          "evidence_refs": {
            "title": "evidence_refs",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
            }
          }
        },
        "required": [
          "issue_id",
          "severity",
          "code",
          "message",
          "slide_id"
        ]
      }
    },
    "report_id": {
      "title": "report_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "task_id": {
      "title": "task_id",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "deck_hash": {
      "title": "deck_hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "passed": {
      "title": "passed",
      "type": "boolean"
    },
    "created_at": {
      "title": "created_at",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "format": "date-time"
    }
  },
  "required": [
    "issues",
    "report_id",
    "task_id",
    "deck_hash",
    "passed",
    "created_at"
  ]
}
